{
  "name": "cleanshot",
  "version": "1.1.0",
  "private": true,
  "description": "CleanShot — Client-side metadata remover, inspector, and Gemini watermark remover",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/copy-exiftool-wasm.mjs && node scripts/copy-gwr-video-assets.mjs"
  },
  "dependencies": {
    "@lilohuang/exiftool": "1.0.10",
    "@pilio/gemini-watermark-remover": "^1.0.46",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "fflate": "^0.8.2",
    "framer-motion": "^11.11.9",
    "jszip": "^3.10.2",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "onnxruntime-web": "^1.31.1",
    "pdf-lib": "^1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@emnapi/runtime": "1.11.3",
    "@types/node": "^20.17.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.7.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
